# Neon Postgres (added automatically by the Vercel ↔ Neon integration)
DATABASE_URL=

# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=
# Your channel ID, starts with "UC…"
YOUTUBE_CHANNEL_ID=

# Password for /admin
ADMIN_PASSWORD=
# Random 32+ character string used to sign the admin session cookie and salt vote hashes
# e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Random string; Vercel Cron sends it as a Bearer token to /api/cron/sync
CRON_SECRET=
